{
  "policy_version": "2.0.0",
  "source_policy": "warranty_policies.json",
  "common": {
    "ocr_low_confidence_threshold": 0.7,
    "warranty_proof_any_of": [
      "electronic_warranty",
      "warranty_card",
      "purchase_receipt"
    ],
    "common_excluded_causes": [
      "Accidental Damage",
      "Physical Damage",
      "Misuse",
      "Unauthorized Modification",
      "Normal Wear",
      "Water Damage"
    ],
    "repair_report_required_if_previous_repair": true,
    "identity_match_required": true,
    "duplicate_claim_hard_invalid": true
  },
  "decision_rules": {
    "warranty_start_conditions": [
      "Warranty begins from verified purchase date.",
      "Purchase evidence must be available or verifiable."
    ],
    "repair_conditions": {
      "previous_repair_requires_report": true,
      "unauthorized_repair_is_hard_fail": true
    },
    "authorized_service_centre_required": true,
    "replacement_conditions": {
      "replacement_history_must_be_verified": true
    },
    "grace_period_days": 0,
    "hard_fail_rules": [
      "warranty_expired",
      "fault_not_covered",
      "component_not_eligible",
      "reporting_period_exceeded",
      "unauthorized_previous_repair"
    ],
    "warning_rules": [
      "low_ocr_confidence",
      "document_duplicate_indicator"
    ],
    "manual_review_rules": [
      "model_disagreement",
      "low_model_confidence",
      "large_confidence_difference",
      "required_documents_incomplete",
      "critical_document_missing",
      "repair_report_missing_or_unknown",
      "serial_verification_issue",
      "product_identity_issue",
      "product_model_inconsistency",
      "duplicate_claim_indicator",
      "contradiction_indicator"
    ]
  },
  "categories": {
    "Laptop": {
      "standard_warranty_months": 24,
      "reporting_deadline_days": 30,
      "identity_type": "SerialOrServiceTag",
      "service_mode": "CarryIn",
      "components": {
        "Main Unit": {
          "warranty_months": 24,
          "warranty_eligible": true
        },
        "Battery": {
          "warranty_months": 12,
          "warranty_eligible": true
        },
        "Power Adapter": {
          "warranty_months": 12,
          "warranty_eligible": true
        }
      },
      "potentially_covered_faults": [
        "Power Failure",
        "Display Failure",
        "Battery Problem",
        "Overheating",
        "Connectivity Issue"
      ],
      "additional_excluded_causes": [
        "Liquid Damage"
      ],
      "required_evidence": [
        "warranty_proof",
        "identity_evidence",
        "fault_evidence"
      ],
      "conditional_evidence": {
        "previous_repair": [
          "repair_report"
        ],
        "battery_claim": [
          "battery_diagnostic"
        ]
      },
      "category_specific_fields": [
        "ServiceTagVerified",
        "BatteryHealthPercent",
        "BatteryCycleCount",
        "DiagnosticCodeAvailable",
        "PhysicalDamageIndicator",
        "LiquidDamageIndicator"
      ],
      "installation_required": false,
      "usage_limit": null
    },
    "Smartphone": {
      "standard_warranty_months": 12,
      "reporting_deadline_days": 30,
      "identity_type": "IMEIOrSerial",
      "service_mode": "CarryIn",
      "components": {
        "Main Unit": {
          "warranty_months": 12,
          "warranty_eligible": true
        },
        "Battery": {
          "warranty_months": 12,
          "warranty_eligible": true
        },
        "Charger": {
          "warranty_months": 6,
          "warranty_eligible": true
        }
      },
      "potentially_covered_faults": [
        "Power Failure",
        "Display Failure",
        "Battery Problem",
        "Overheating",
        "Connectivity Issue"
      ],
      "additional_excluded_causes": [
        "Liquid Damage",
        "Rooted Or Unauthorized Software Modification"
      ],
      "required_evidence": [
        "warranty_proof",
        "identity_evidence",
        "fault_evidence"
      ],
      "conditional_evidence": {
        "previous_repair": [
          "repair_report"
        ],
        "battery_claim": [
          "battery_diagnostic"
        ]
      },
      "category_specific_fields": [
        "IMEIVerified",
        "ActivationDateVerified",
        "BatteryHealthPercent",
        "PhysicalDamageIndicator",
        "LiquidDamageIndicator"
      ],
      "installation_required": false,
      "usage_limit": null
    }
  }
}